# Multi-stage training image for Digimon TCG RL
#
# Stage 1: Compile the digimon-engine-py PyO3 wheel (Rust + Python headers)
# Stage 2: Lean Python training runtime — copies the wheel, installs deps
#
# Build: docker build -f Dockerfile.training -t digimon-trainer .
# Run:   docker run --gpus all --rm \
#          -v $(pwd)/models:/app/models \
#          -v $(pwd)/data:/app/data \
#          -e DIGIMON_BACKEND=rust \
#          digimon-trainer training_jobs/my_job.json

# ── Stage 1: Rust build ───────────────────────────────────────────────────
# Pinned to match the local developer toolchain (rustc 1.94). Bumps to follow
# any dep that requires a newer Cargo feature; ureq-proto 0.6 needs
# edition2024 which only stabilized in 1.85, so 1.82 is below the floor.
FROM rust:1.94-slim AS rust-builder

WORKDIR /build

# Use the distro's default Python (`python3-dev`) for the maturin build.
# The PyO3 binding is abi3-py311 (see code/digimon-engine-py/Cargo.toml),
# so the resulting wheel tags as cp311-abi3-manylinux and installs into
# the Stage 2 python:3.11-slim runtime regardless of which 3.x is used
# to build it. Pinning a specific minor (python3.11-dev / 3.12-dev) is
# fragile because the package only exists on the Debian release that
# ships that exact version as default — Bookworm = 3.11, Trixie = 3.13.
#
# g++ is required because the `ort` (ONNX Runtime) crate links against
# libstdc++; rust:*-slim is too minimal to provide it by default.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev python3-pip g++ libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

# --break-system-packages is the right idiom for a throwaway build
# container under Debian Bookworm (PEP 668). The wheel is copied into the
# Stage 2 image; this Stage 1 Python is never shipped.
RUN pip install --no-cache-dir --break-system-packages maturin

# Copy workspace manifests and lock file first for better layer caching
COPY Cargo.toml Cargo.lock ./

# Copy only the crates needed for the PyO3 wheel
COPY code/digimon-dsl/ code/digimon-dsl/
COPY code/digimon-engine/ code/digimon-engine/
COPY code/digimon-engine-py/ code/digimon-engine-py/

# The engine uses `include_str!` to embed JSON AT COMPILE TIME (paths are
# relative to the source file, walking up three levels to the repo root):
#   code/digimon-engine/src/deck_tools.rs -> data/cards.json, data/tested_cards.json
#   code/digimon-engine/src/format.rs     -> data/deck_formats.json
# All three are required for `cargo build` to succeed; the larger
# deck_library.json is runtime-only and is intentionally left out of the
# build context.
COPY data/cards.json data/tested_cards.json data/deck_formats.json data/

# Trim the workspace so unrelated members don't have to resolve.
# Only digimon-dsl + digimon-engine + digimon-engine-py are copied above;
# the cli, mcp, tauri shell, and ALL code/tools/* crates must be dropped from
# `members` or `cargo metadata` fails before maturin can build the wheel.
# Match every code/tools/* member (dsl-schema-export, dsl-lint,
# action-space-export, dcgo-replay, archetype-static-tests, and any future
# tool) so a newly-added tool crate can't silently break the training image.
RUN sed -i -E '/"code\/(src-tauri|digimon-engine-cli|digimon-engine-mcp|tools\/[a-z0-9-]+)"/d' Cargo.toml

# Build the wheel — release mode for maximum speed at training time
RUN cd code/digimon-engine-py && maturin build --release --out /wheels


# ── Stage 2: Python training runtime ─────────────────────────────────────
FROM python:3.11-slim

WORKDIR /app

# openssh-server is required for RunPod's SSH proxy to reach the container.
# Without it, RunPod's "ssh info" stays "pod not ready" forever even though
# the container itself is running. For Path B (Hetzner one-shot) this just
# adds ~5 MB of unused binaries; for Path A (RunPod) it's essential.
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-server \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /run/sshd \
    && sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin yes/' /etc/ssh/sshd_config \
    && sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config \
    && printf 'PYTHONPATH=/app\nDIGIMON_DATA_DIR=/app/data\nDIGIMON_BACKEND=rust\n' >> /etc/environment

# Install the compiled PyO3 wheel
COPY --from=rust-builder /wheels/*.whl /wheels/
RUN pip install --no-cache-dir /wheels/*.whl && rm -rf /wheels

# Install Python training dependencies
COPY requirements-training.txt .
RUN pip install --no-cache-dir -r requirements-training.txt

# Copy training-side source (flatten code/ → /app/).
#
# Only run_training_job.py is copied from code/tools/ — the training entrypoint
# (run_training_job.py → digimon_gym.agents.pilot_training) imports only
# digimon_engine (the Rust wheel), data_paths, and digimon_gym.*. The Python
# legacy engine has been deleted entirely (engine_py_legacy no longer exists in
# the repo), so this image is legacy-free by construction; copying only the one
# entrypoint file still keeps the image lean. `tools` is a namespace package (no
# __init__.py), so the single file resolves as `tools.run_training_job` with
# /app on PYTHONPATH. A guardrail test (code/tests/rl) + the CI smoke step (real
# import) enforce that the training chain stays legacy-free.
COPY code/digimon_gym/ digimon_gym/
COPY code/tools/run_training_job.py tools/run_training_job.py
# Deck-specialist league (add-deck-specialist-league): the round-based driver and
# the anchored-eval CLI it loads as a sibling (for the matchup matrix + the
# promotion gate). Both import only digimon_gym.* + digimon_engine, so the image
# stays lean + legacy-free.
COPY code/tools/train_specialist_league.py tools/train_specialist_league.py
COPY code/tools/anchored_eval_cli.py tools/anchored_eval_cli.py
COPY code/data_paths.py .
COPY training_jobs/ training_jobs/

# Card data is mounted at runtime: -v $(pwd)/data:/app/data
#
# data_paths.py computes REPO_ROOT as `__file__.parent.parent`. In the
# repo, data_paths.py lives at code/data_paths.py, so the walk reaches
# the repo root correctly. Inside this image we flatten code/ to /app/,
# which makes __file__.parent.parent = / (one level too high) and
# DATA_DIR defaults to /data instead of /app/data. Override explicitly
# so the data_paths module resolves the runtime volume mount.
ENV DIGIMON_DATA_DIR=/app/data

# Use the Rust engine backend by default
ENV DIGIMON_BACKEND=rust

# `python tools/run_training_job.py` puts /app/tools on sys.path[0], but
# digimon_gym lives at /app/digimon_gym — not on the path otherwise. Make
# /app itself importable so `from digimon_gym.X import Y` resolves
# without requiring the source tree to be pip-installed.
ENV PYTHONPATH=/app

# No ENTRYPOINT so the image works as both a one-shot trainer and an
# interactive pod.
#
# Path B (one-shot on Hetzner / DO via `docker run`):
#   docker run --rm ... <image> python tools/run_training_job.py /app/jobs/my.json
#   (the args override CMD; sshd is never started; trainer runs and exits)
#
# Path A (RunPod pod, want to SSH in and stage data before training):
#   runpodctl pod create ...
#   (default CMD runs runpod-start.sh: installs $PUBLIC_KEY, starts sshd,
#    then sleeps forever so RunPod's SSH proxy can connect)
COPY docker/runpod-start.sh /usr/local/bin/runpod-start.sh
RUN chmod +x /usr/local/bin/runpod-start.sh
CMD ["/usr/local/bin/runpod-start.sh"]
