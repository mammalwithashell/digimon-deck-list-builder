          "combo": "Lamiamon security swap feeds memory engine",
          "status": "PASS",
          "tests": [
            "lamiamon_security_swap_feeds_inherited_memory"
          ],
          "note": "Real [BT24-008 Elizamon, BT24-016 Lamiamon] stack: the swap top-security trash pays out the buried Elizamon inherited (+1 memory)."
        },
        {
          "combo": "EX11-012 token-shield (faithfulness gap)",
          "status": "PASS (gap fixed)",
          "tests": [
            "ex11_012_survives_by_deleting_opponents_petrification_token"
