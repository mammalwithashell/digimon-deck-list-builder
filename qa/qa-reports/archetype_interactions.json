      "findings": [
        {
          "id": "G-PLAY-TOKEN-FLOODGATE",
          "combo": "S1 Pillomon flood-gate vs Familiar Token plays",
          "status": "RESOLVED",
          "test": "s1_pillomon_floodgate_blocks_effect_token_plays (#[ignore])",
          "tracker": "docs/RUST_ENGINE_GAPS.md",
          "summary": "EffectContext::play_token bypasses CannotPlayDigimonByEffect; under Pillomon (BT9-033), effect-played Familiar Tokens still spawn (engine spawned 2, faithful=0). DCGO blocks via CanPlayAsNewPermanent -> CanNotPutFieldClass (IsDigimon). Engine-primitive gap.",
          "resolution": "play_token now consults CannotPlayDigimonByEffect (effect_context/mod.rs). Pins: s1 + s1b interaction tests; play_token_blocked/allowed lib unit tests. Test un-ignored."
        },
        {
          "id": "G-EX11-023-TOKEN-DELETION",
          "combo": "S3 Kaguyamon recursion on Familiar Token deletion",
          "status": "RESOLVED",
          "test": "s3_kaguyamon_recursion_fires_on_familiar_token_deletion (#[ignore])",
          "tracker": "qa/archetype-qa/engine-gaps.md",
          "summary": "EX11-023 recursion condition is event_target_kind: digimon only; Familiar Tokens are CardKind::Token, so a token deletion does not fire the trash-recursion. DCGO gates on IsDigimon (true for tokens). One-line DSL fix: add token to the any_of (sibling cards BT22-040/EX11-060 already do).",
          "resolution": "EX11-023.yaml condition now any_of:[digimon,token]. Pins: s3 interaction test; ex11_023 per-card token-deletion + strengthened structural test. Test un-ignored."
        }
      ],
