    "ST-1 Gaia Red": {
      "combos_tested": [
        {
          "combo": "Tall-stack security rush",
          "note": "WarGreymon base-inclusive formula FIXED at card layer (ST1-11 base:2); Greymon-free stack checks 3; full WarGreymon+Greymon line checks 4 (inherited keyword counted via tick-fresh strike)",
          "status": "PASS",
          "tests": [
            "tall_stack_security_rush_aura_adds_to_base_one_check",
            "tall_stack_security_rush_full_line_checks_four_security"
          ]
        },
        {
          "combo": "Tai anthem additive stack",
          "note": "",
          "status": "PASS",
          "tests": [
            "tai_anthem_additive_stack_layers_on_one_body_and_spares_opponent"
          ]
        },
        {
          "combo": "Garudamon buff survives removal",
          "note": "",
          "status": "PASS",
          "tests": [
            "garudamon_buff_survives_gaia_force_removal"
          ]
        }
      ],
      "findings": [
        {
          "desc": "WarGreymon <Security A.> formula under-counted: ST1-11 authored its security_attack_fn as a bare delta (base:0 -> floor(n/2)) but the engine's formula contract is base-inclusive, so the base-1 was dropped. Fixed at card layer (base:2 -> 1+floor(n/2)); the earlier engine base-fold was the wrong layer and double-counted correctly-authored formulas.",
          "resolved": "2026-05-30",
          "severity": "card-bug",
          "status": "RESOLVED",
          "test": "st1_gaia_red::tall_stack_security_rush_aura_adds_to_base_one_check",
          "tracker": "docs/RUST_ENGINE_GAPS.md"
        },
        {
          "desc": "declarative inherited <Security A. +/-N> grants (DSL grant_keyword) not summed by the security strike — WarGreymon+Greymon checked 3, should be 4",
          "note": "real fix: current_security_strike ticks declarative effects before reading the keyword term (tick-fresh strike), and tick_declarative_effects skips materializing a face-printed own grant (de-overlap) so all five <Security A.> representations single-count",
          "resolved": "2026-05-30",
          "severity": "engine-bug",
          "status": "RESOLVED",
          "test": "st1_gaia_red::tall_stack_security_rush_full_line_checks_four_security",
          "tracker": "docs/RUST_ENGINE_GAPS.md"
        }
      ],
