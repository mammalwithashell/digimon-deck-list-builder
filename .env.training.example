# Training environment variables
# Copy to .env.training and fill in your values.
# This file is sourced by scripts/train_remote.sh before each run.

# ── DigiLab DB (read-only, for scoped meta queries) ───────────────────────
# Required when any training job uses a meta_scope block.
# Override the default connection string if your DB credentials differ.
PGPASSWORD=
# DIGILAB_CONN_STR=postgresql://user:pass@host/dbname?sslmode=require

# ── Hosted API (for model publishing) ────────────────────────────────────
# Required only when running train_remote.sh with --publish.
API_BASE_URL=http://localhost:8000
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── DigitalOcean Spaces (populated automatically by the API) ─────────────
# These are set in the API server's environment, not here.
# Listed for reference — the publish flow goes through the API, not directly.
# SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# SPACES_BUCKET=digimon-tcg-models
# SPACES_KEY=
# SPACES_SECRET=
# SPACES_CDN_URL=https://digimon-tcg-models.nyc3.cdn.digitaloceanspaces.com

# ── SSH key for train_remote.sh ───────────────────────────────────────────
# Defaults to ~/.ssh/id_rsa if not set.
# SSH_KEY=~/.ssh/id_rsa
