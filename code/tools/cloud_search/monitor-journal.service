[Unit]
Description=Read-only training log mirror for the Digimon W&B monitor
After=systemd-journald.service

[Service]
Type=simple
ExecStart=/usr/bin/journalctl --unit=digimon-search --follow --output=cat --no-pager --lines=all
StandardOutput=append:/opt/digimon-search/monitor/training.log
Restart=on-failure
RestartSec=30
Nice=15

[Install]
WantedBy=multi-user.target
