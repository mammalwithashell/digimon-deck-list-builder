# Desktop-build env — baked into the production bundle by `vite build --mode desktop`.
# NOT secret: anything here ships to end users. Do not put credentials in this file.
#
# These are the real production URLs (hosted FastAPI on the DO droplet).
# They are the values that ship in release builds: cargo tauri build's
# beforeBuildCommand reruns `npm run build:desktop` WITHOUT the workflow's
# env vars, so this file — not CI env — is what ends up in the installer.
VITE_BUILD_TARGET=desktop
VITE_API_URL=https://inbetweentheatre.duckdns.org
VITE_MODELS_MANIFEST_URL=https://inbetweentheatre.duckdns.org
