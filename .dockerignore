!code/data_paths.py
!data/
!alembic/
!alembic.ini
!Cargo.toml
!Cargo.lock
!requirements-server.txt
# Re-excludes inside the allowed trees
code/engine_py_legacy/tests/
**/target/
**/node_modules/
**/__pycache__/
**/*.pyc
