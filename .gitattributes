# Shell scripts, Dockerfiles, and compose files must be LF so they work on
# Linux runners (CI, droplet) even when edited from Windows checkouts.
*.sh text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Caddyfile text eol=lf

# Per-card metadata is byte-exact-checked by tools/build_card_meta --check.
# Force LF on every platform so the generator's output matches the on-disk
# tree on Windows checkouts.
data/card_meta/** text eol=lf

# The oracle readiness artifact is byte-deterministic (tools/clause_coverage/readiness.py
# --check); keep it LF on every platform for the same reason.
data/oracle_readiness.json text eol=lf

# The exam attempt log is append-only history from parallel oracle nodes.
# Union merge concatenates both sides instead of conflicting; the log is
# one JSON object per line precisely so this is correct.
qa/qa-reports/exam-log.jsonl merge=union

# card-loop ledgers (openspec add-card-authoring-loop, design D11): append-only
# JSONL written by concurrent runs on different branches. Union merge keeps
# every side's rows; LF so a Windows checkout never mixes line endings.
qa/card-loop/attempts.jsonl merge=union text eol=lf
qa/card-loop/corrections.jsonl merge=union text eol=lf
qa/card-loop/audits.jsonl merge=union text eol=lf
