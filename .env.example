# DigiLab MotherDuck database token (optional, for meta stats enrichment)
MOTHERDUCK_TOKEN=

# OpenAI task pipeline
# Note: FastAPI startup auto-loads this .env (no manual shell export required).
OPENAI_API_KEY=
OPENAI_MODEL_REVIEW=gpt-4.1
OPENAI_MODEL_QA=gpt-4.1-mini
OPENAI_MODEL_ENGINE=gpt-4.1-mini
OPENAI_MODEL_AUTOFIX=gpt-4.1
AI_TASK_MAX_COST_USD=5.0
AI_WORKER_POLL_SECONDS=2.0
AI_WORKER_STALE_SECONDS=1800
AI_BATCH_FAILURE_MIN_SAMPLE=10
AI_APPLY_MAIN_ALLOWED=0

# DigitalOcean Spaces (S3-compatible object storage for RL model publishing)
# SPACES_ENDPOINT, BUCKET, REGION, KEY, SECRET are required on the hosted API
# whenever admin model upload/confirm/publish or the public /models/manifest.json
# endpoint is used. SPACES_CDN_URL is optional: when set, the manifest's
# download URLs use the Spaces CDN base (edge-cached) instead of the direct
# bucket endpoint. Leave SPACES_CDN_URL unset in dev to hit the origin directly.
# Full reference: docs/ENVIRONMENT.md#model-publishing--digitalocean-spaces
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_BUCKET=digimon-tcg-models
SPACES_REGION=nyc3
SPACES_KEY=
SPACES_SECRET=
SPACES_CDN_URL=https://digimon-tcg-models.nyc3.cdn.digitaloceanspaces.com

# Gate ranked matchmaking — leave unset for alpha, set to 1 to enable
MATCHMAKING_RANKED_ENABLED=0
