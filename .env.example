# DigiLab MotherDuck database token (optional, for meta stats enrichment)
MOTHERDUCK_TOKEN=

# OpenAI task pipeline
# Note: FastAPI startup auto-loads this .env (no manual shell export required).
OPENAI_API_KEY=
OPENAI_MODEL_REVIEW=gpt-4.1
OPENAI_MODEL_QA=gpt-4.1-mini
OPENAI_MODEL_ENGINE=gpt-4.1-mini
OPENAI_MODEL_AUTOFIX=gpt-4.1
AI_TASK_MAX_COST_USD=5.0
AI_WORKER_POLL_SECONDS=2.0
AI_WORKER_STALE_SECONDS=1800
AI_BATCH_FAILURE_MIN_SAMPLE=10
AI_APPLY_MAIN_ALLOWED=0

# Gate ranked matchmaking — leave unset for alpha, set to 1 to enable
MATCHMAKING_RANKED_ENABLED=0
