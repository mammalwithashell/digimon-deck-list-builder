# Desktop-build env — baked into the production bundle by `vite build --mode desktop`.
# NOT secret: anything here ships to end users. Do not put credentials in this file.
#
# The URLs below are PLACEHOLDERS. Swap them to the real production host
# (the hosted FastAPI that serves /models/manifest.json and the REST API)
# before cutting a release.
VITE_BUILD_TARGET=desktop
VITE_API_URL=https://api.digimon-tcg.example
VITE_MODELS_MANIFEST_URL=https://api.digimon-tcg.example
