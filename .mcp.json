{
  "mcpServers": {
    "pinecone-mcp": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@pinecone-database/mcp"],
      "env": {
        "PINECONE_API_KEY": "${PINECONE_API_KEY}"
      }
    },
    "obsidian": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@mauricio.wolff/mcp-obsidian@latest", "C:\\Users\\james\\OneDrive\\Documents\\Obsidian Vault"]
    },
    "digimon-engine-mcp": {
      "type": "stdio",
      "command": "target/debug/digimon-engine-mcp.exe",
      "args": ["--pool", "implemented"]
    },
    "digimon-training-mcp": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "digimon_training_mcp", "--runs-dir", "./runs", "--models-dir", "./models"]
    },
    "digimon-scenario-mcp": {
      "type": "stdio",
      "command": "python",
      "args": ["-m", "digimon_scenario_mcp", "--browser-url", "http://127.0.0.1:8000"]
    },
    "dcgo-exam": {
      "type": "stdio",
      "command": "cargo",
      "args": ["run", "-q", "-p", "dcgo-harness", "--", "mcp"]
    }
  }
}
