{
  "job_name": "medusamon_vs_boardwalk",
  "description": "Train Medusamon to beat the Boardwalk Games local meta",

  "agent_deck": {
    "source": "file",
    "path": "decks/medusamon_list.json"
  },

  "meta_scope": {
    "store_ids": [6],
    "since_date": "2025-10-01"
  },

  "training": {
    "timesteps": 500000,
    "opponent": "greedy",
    "use_lstm": true,
    "lstm_hidden_size": 256,
    "learning_rate": 3e-4,
    "n_steps": 2048,
    "batch_size": 64,
    "eval_freq": 10000,
    "n_eval_episodes": 20,
    "bounty_threshold": 0.15,
    "bounty_bonus": 0.5
  },

  "output": {
    "name": "medusamon_boardwalk_v1",
    "save_dir": "models",
    "log_dir": "runs/pilot_ppo"
  }
}
